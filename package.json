{
  "name": "3descu-social-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Free publisher for the pre-written 3Descu social calendar (Facebook Page + Instagram Business via the Meta Graph API)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "publish:due": "node src/main.ts",
    "publish:dry": "node src/main.ts --dry-run",
    "build:schedule": "node scripts/build-schedule.ts",
    "build:media": "node scripts/build-schedule.ts --copy-media",
    "test": "node --test test/check.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "csv-parse": "^7.0.3",
    "eslint": "^10.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1"
  }
}
