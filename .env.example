# ─── Research ───────────────────────────────────────────────
# Tavily API key (free tier: 1000 queries/mo) — https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Content generation ─────────────────────────────────────
# Anthropic API key — https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Image generation (Cloudflare Workers AI, free tier) ────
# Get from Cloudflare dashboard → Workers AI → API tokens
# Free tier: ~300 Flux Schnell images/day
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Image hosting (Supabase — you already have this project) ─
# Use the existing 3descu Supabase project; create a new PUBLIC bucket named `social-posts`
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI...

# ─── Meta Graph API (FB Page + IG Business) ─────────────────
# Long-lived Page Access Token from Meta Business Suite
# Both channels share this — one OAuth flow covers both
META_PAGE_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxx
META_FB_PAGE_ID=1234567890123456
META_IG_BUSINESS_ACCOUNT_ID=17841400000000000

# ─── LinkedIn UGC Posts API (personal profile, no approval needed) ─
# Standard OAuth flow, w_member_social scope, refresh-token pattern
LINKEDIN_ACCESS_TOKEN=AQxxxxxxxxxxxxxxxxxxxxxxxx
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxxxx

# ─── LinkedIn Community Management API (Company Page) — OPTIONAL ─
# Only fill after your app is approved for Development Tier (2-6 wk wait)
LINKEDIN_ORG_URN=urn:li:organization:xxxxxxxxxx

# ─── YouTube Data API v3 (self-serve, free) ─────────────────
# Google Cloud project → enable YouTube Data API v3 → OAuth
YOUTUBE_REFRESH_TOKEN=1//0xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx

# ─── Telegram approval bot (BotFather → /newbot) ────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=1234567890
# Set to 1 to require Telegram approval per post; 0 for full auto
APPROVAL_LOOP=1

# ─── Run mode ───────────────────────────────────────────────
# DRY_RUN=1 skips actual publishing (still runs research + captions + images)
DRY_RUN=0
