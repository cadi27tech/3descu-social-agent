# Local run only. In GitHub these are Actions secrets. Leave any of the three empty = dry run.
META_PAGE_ID=
META_IG_USER_ID=
META_SYSTEM_USER_TOKEN=

# Optional repo variable. Default: https://raw.githubusercontent.com/cadi27tech/3descu-social-agent/main/media
MEDIA_BASE_URL=

# Optional: pretend it is this instant (UTC ISO), useful with --dry-run
NOW=
